# ─────────────────────────────────────────────────────────────
# zycron — variáveis de ambiente (exemplo)
# Copie para `.env` e preencha. NUNCA versione o `.env` real.
# ─────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────
NODE_ENV=development
BACKEND_PORT=3333
# Porta do backend Python/FastAPI durante a migracao incremental.
PY_BACKEND_PORT=8000
# Em produção (Render), a plataforma injeta PORT automaticamente — não precisa setar.
FRONTEND_PORT=3000
# URL pública do backend consumida pelo frontend (em prod: URL do serviço no Render)
NEXT_PUBLIC_API_URL=http://localhost:3333

# ── MongoDB ──────────────────────────────────────────────────
# Use sempre a connection string do banco remoto/VPS. O backend nao cai mais
# automaticamente para Mongo local se esta variavel estiver ausente.
MONGODB_URI=mongodb+srv://app_production:senha-forte@cluster.mongodb.net/tecnoplus?retryWrites=true&w=majority
MONGODB_DATABASE=tecnoplus
MONGODB_MIN_POOL_SIZE=0
MONGODB_MAX_POOL_SIZE=10
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
MONGODB_CONNECT_TIMEOUT_MS=10000
MONGODB_SOCKET_TIMEOUT_MS=45000
# Compatibilidade temporaria com deploys antigos; prefira MONGODB_*.
MONGO_URI=
MONGO_DB_NAME=

# ── Filas ────────────────────────────────────────────────────
# Não há mais Redis/BullMQ: o pipeline de IA roda no próprio backend, em segundo
# plano, usando o MongoDB para persistir estado. Nenhuma variável necessária.

# ── Autenticação (JWT) ───────────────────────────────────────
JWT_SECRET=troque-por-um-segredo-forte-de-32+chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=troque-por-outro-segredo-forte
JWT_REFRESH_EXPIRES_IN=7d

# ── Provedores de IA (por capacidade) ───────────────────────
# Opções: openai | claude | gemini
AI_PROVIDER=gemini
# Gemini lê/trata as IMAGENS; Claude escreve os TÍTULOS/descrições
AI_VISION_PROVIDER=gemini
AI_TEXT_PROVIDER=claude
AI_VISION_MODEL=gemini-flash-latest
AI_TEXT_MODEL=claude-haiku-4-5
# Modelo de imagem (Gemini "Nano Banana") — recorta o fundo e recompõe o produto
# nas 3 imagens da Shopee. Usa a GEMINI_API_KEY. Se o modelo não estiver
# disponível na sua chave, o sistema cai no fallback (foto em fundo branco 1:1).
AI_IMAGE_MODEL=gemini-2.5-flash-image

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ── Telegram (bot de cadastro) ───────────────────────────────
# Token do @BotFather. IDs autorizados separados por vírgula.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Catálogo compartilhado dos cadastros do bot (dedup vale p/ todos)
TELEGRAM_OWNER_ID=bras
# Opcional: usuário do bot (sem @), só pra montar o link de vínculo do fornecedor
TELEGRAM_BOT_USERNAME=

# ── WhatsApp / WPPConnect Server ─────────────────────────────
# API self-hosted do WPPConnect Server. Localmente, o docker-compose abaixo
# expõe em http://localhost:21465. Em produção use a URL pública/privada da VPS.
WPPCONNECT_BASE_URL=http://localhost:21465
WPPCONNECT_SESSION=tecnoplus
WPPCONNECT_SECRET_KEY=troque-por-um-segredo-do-wppconnect
# Opcional: se já tiver gerado o token no WPPConnect, informe aqui; se ficar
# vazio, o backend gera via WPPCONNECT_SECRET_KEY.
WPPCONNECT_TOKEN=
# URL pública do webhook que o WPPConnect chama ao receber eventos.
# Ex.: https://api.seudominio.com/api/whatsapp/webhook
WPPCONNECT_WEBHOOK_URL=
# Segredo enviado pelo WPPConnect no header x-wppconnect-secret se você configurar
# esse header no proxy/servidor. Se vazio, o webhook só registra os eventos.
WPPCONNECT_WEBHOOK_SECRET=
# Base usada quando um produto ainda não tem link público da Shopee/Mercado Livre.
WPPCONNECT_PRODUCT_LINK_BASE_URL=http://localhost:3000
WPPCONNECT_MAX_PHONES_PER_BLAST=50
WPPCONNECT_MAX_PRODUCTS_PER_BLAST=10

# ── Supabase Storage ─────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=product-images

# ── Facebook / Instagram (postagem automática com aprovação) ───
# App Secret: developers.facebook.com/apps/<APP_ID>/settings/basic — só o
# dono da conta consegue revelar (botão "Mostrar" + senha).
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# ID da Página do Facebook a ser conectada.
FACEBOOK_PAGE_ID=
# Gerar em developers.facebook.com/tools/explorer com escopos
# pages_manage_posts + instagram_content_publish.
FACEBOOK_PAGE_ACCESS_TOKEN=
# ID da conta comercial do Instagram vinculada à Página.
INSTAGRAM_BUSINESS_ACCOUNT_ID=
FACEBOOK_API_VERSION=v19.0
# Hora local (0-23) em que o rascunho diário é mandado pro Telegram p/ aprovação.
SOCIAL_POST_HOUR=9
# Marketing IA — publicação automática dos posts do calendário (Facebook/Instagram).
# Nasce OFF de propósito: publicar de verdade na Página/perfil é consequente,
# só ative depois de revisar o calendário gerado. Roda no processo do bot
# (npm run bot / bot:dev), igual ao SOCIAL_POST_HOUR acima.
MARKETING_AUTO_PUBLISH=false
# Marketing IA — geração automática diária (analisa produtos novos + gera o
# próximo dia do calendário + gera imagem de cada post). NÃO publica nada,
# só popula o calendário — por isso nasce LIGADO. Defina =false pra desligar
# e usar só os botões manuais. Roda no processo do bot (npm run bot/bot:dev).
MARKETING_AUTO_GENERATE=true
# Hora local (0-23) em que a geração automática diária roda.
MARKETING_GENERATE_HOUR=6

# ── Regras de precificação (padrão, sobrescrevível por config) ─
PRICING_MARKUP_TIER1=1.20
PRICING_MARKUP_TIER2=0.90
PRICING_MARKUP_TIER3=0.70
PRICING_MARKUP_TIER4=0.50

# ── Segurança ────────────────────────────────────────────────
# Em produção: URL do frontend na Vercel (ex.: https://seu-app.vercel.app)
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=120
# Criptografa (AES-256-GCM) os tokens de integração (Shopee, Mercado Livre) em
# repouso no Mongo. Qualquer string forte serve (mesmo padrão do JWT_SECRET) —
# troque em produção; se mudar depois de já ter conexões salvas, elas precisam
# reconectar.
TOKEN_ENCRYPTION_KEY=troque-por-um-segredo-forte-de-32+chars

# ── Shopee — Importação em Massa ────────────────────────────
# Caminho absoluto do .xlsx oficial baixado no Seller Center (aba "Modelo").
# Sem isso, o exportador cai no esquema de referência (não aceito pelo
# importador da Shopee). Baixe um novo arquivo sempre que a Shopee mudar o
# layout e atualize este caminho. Não versione o arquivo (tem o ID da loja).
SHOPEE_TEMPLATE_PATH=

# ── Shopee Open Platform (integração REAL via API — OAuth + product/order) ──
# Obtidos ao criar o app em open.shopeemobile.com (Live) ou
# open.shopeemobile.com/documents (Sandbox/Test). Sem isso, a tela de
# Integrações mostra "não configurado" e a conexão de loja fica desabilitada.
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
# Produção: https://partner.shopeemobile.com
# Sandbox (testes, sem loja real): https://partner.test-stable.shopeemobile.com
SHOPEE_API_HOST=https://partner.shopeemobile.com
# Opcional. No sandbox, a tela de autorizacao pode usar outro dominio:
# https://openplatform.sandbox.test-stable.shopee.sg
SHOPEE_AUTH_HOST=
# URL pública e https do backend + "/api/integrations/shopee/callback" —
# precisa ser cadastrada IDÊNTICA no painel do app da Shopee Open Platform.
# Ex.: https://api.seudominio.com/api/integrations/shopee/callback
SHOPEE_REDIRECT_URL=
SHOPEE_WEBHOOK_URL=
SHOPEE_REGION=BR
SHOPEE_ENVIRONMENT=production

# ── Mercado Livre (integração REAL via API — OAuth2+PKCE + items) ──────
# Obtidos ao criar o app em developers.mercadolivre.com.br (DevCenter). Sem
# isso, a tela de Integrações mostra "não configurado" e a conexão fica
# desabilitada.
MERCADO_LIVRE_CLIENT_ID=
MERCADO_LIVRE_CLIENT_SECRET=
# URL pública e https do backend + "/api/integrations/mercado-livre/callback" —
# precisa ser cadastrada IDÊNTICA no app do DevCenter.
# Ex.: https://api.seudominio.com/api/integrations/mercado-livre/callback
MERCADO_LIVRE_REDIRECT_URI=
# Domínio de autorização varia por país — .com.br é o do Brasil.
MERCADO_LIVRE_AUTH_HOST=https://auth.mercadolivre.com.br
MERCADO_LIVRE_API_HOST=https://api.mercadolibre.com

# Asaas / Financeiro
ASAAS_API_KEY=
ASAAS_ENVIRONMENT=sandbox
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_USER_AGENT=zycron/0.1.0 (Node.js; sandbox)
# Token configurado no Webhook do Asaas. Deve ser diferente da ASAAS_API_KEY.
ASAAS_WEBHOOK_TOKEN=
ASAAS_PLATFORM_FEE=3

# Mercado Pago Pix simples
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_CLIENT_ID=
MERCADO_PAGO_CLIENT_SECRET=
MERCADO_PAGO_ENVIRONMENT=sandbox
MERCADO_PAGO_API_URL=https://api.mercadopago.com
MERCADO_PAGO_WEBHOOK_URL=https://zycron.online/api/dropshipping/mercado-pago/webhook
MERCADO_PAGO_WEBHOOK_SECRET=
