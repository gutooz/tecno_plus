# ─────────────────────────────────────────────────────────────
# Tecno Plus AI Catalog — variáveis de ambiente (exemplo)
# Copie para `.env` e preencha. NUNCA versione o `.env` real.
# ─────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────
NODE_ENV=development
BACKEND_PORT=3333
FRONTEND_PORT=3000
# URL pública do backend consumida pelo frontend
NEXT_PUBLIC_API_URL=http://localhost:3333
# URL pública da própria API — usada para montar as URLs das imagens (GridFS)
PUBLIC_BASE_URL=http://localhost:3333

# ── MongoDB ──────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/tecnoplus
MONGO_DB_NAME=tecnoplus

# ── Redis / BullMQ ───────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Autenticação (JWT) ───────────────────────────────────────
JWT_SECRET=troque-por-um-segredo-forte-de-32+chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=troque-por-outro-segredo-forte
JWT_REFRESH_EXPIRES_IN=7d

# ── Provedor de IA padrão ────────────────────────────────────
# Opções: openai | claude | gemini
AI_PROVIDER=openai
AI_VISION_MODEL=gpt-4o
AI_TEXT_MODEL=gpt-4o-mini

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ── Armazenamento de imagens ─────────────────────────────────
# As imagens ficam no próprio MongoDB (GridFS). Nada a configurar aqui.

# ── Regras de precificação (padrão, sobrescrevível por config) ─
PRICING_MARKUP_TIER1=1.20
PRICING_MARKUP_TIER2=0.90
PRICING_MARKUP_TIER3=0.70
PRICING_MARKUP_TIER4=0.50

# ── Segurança ────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=120
