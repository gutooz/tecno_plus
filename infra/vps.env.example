# Copy this content to the GitHub secret PROD_ENV_FILE and adjust values.
# Do not commit real secrets.

APP_DOMAIN=zycron.online
PUBLIC_APP_URL=https://zycron.online
ACME_EMAIL=gustavosantiago2912@gmail.com

NODE_ENV=production
PORT=3333
MONGO_URI=mongodb://mongo:27017/tecnoplus
MONGO_DB_NAME=tecnoplus

CORS_ORIGIN=https://zycron.online

JWT_SECRET=change-this-strong-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-this-other-strong-secret
