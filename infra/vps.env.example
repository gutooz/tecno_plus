# Copy this content to the GitHub secret PROD_ENV_FILE and adjust values.
# Do not commit real secrets.

APP_DOMAIN=zycron.online
PUBLIC_APP_URL=https://zycron.online
ACME_EMAIL=gustavosantiago2912@gmail.com

NODE_ENV=production
PORT=3333
# Aponte para o Atlas. Nao use mongodb://mongo aqui.
MONGODB_URI=mongodb+srv://app_production:senha-forte@cluster.mongodb.net/tecnoplus?retryWrites=true&w=majority
MONGODB_DATABASE=tecnoplus
MONGODB_MIN_POOL_SIZE=0
MONGODB_MAX_POOL_SIZE=10
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
MONGODB_CONNECT_TIMEOUT_MS=10000
MONGODB_SOCKET_TIMEOUT_MS=45000
# Compatibilidade temporaria com deploys antigos; prefira MONGODB_*.
MONGO_URI=
MONGO_DB_NAME=

CORS_ORIGIN=https://zycron.online

JWT_SECRET=change-this-strong-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-this-other-strong-secret
JWT_REFRESH_EXPIRES_IN=7d

AI_PROVIDER=gemini
AI_VISION_PROVIDER=gemini
AI_TEXT_PROVIDER=gemini
AI_VISION_MODEL=gemini-flash-latest
AI_TEXT_MODEL=gemini-flash-latest
AI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=product-images

# Bot do Telegram (serviço "bot" no docker-compose.prod.yml) — sem essas
# variáveis o bot sobe mas fica sem token / sem chats autorizados.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_OWNER_ID=

SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_ENVIRONMENT=production
SHOPEE_REGION=BR
SHOPEE_API_HOST=https://partner.shopeemobile.com
SHOPEE_AUTH_HOST=https://partner.shopeemobile.com
SHOPEE_REDIRECT_URL=https://zycron.online/api/integrations/shopee/callback
SHOPEE_WEBHOOK_URL=https://zycron.online/api/integrations/shopee/webhook

PRICING_MARKUP_TIER1=1.20
PRICING_MARKUP_TIER2=0.90
PRICING_MARKUP_TIER3=0.70
PRICING_MARKUP_TIER4=0.50

ASAAS_API_KEY=
ASAAS_ENVIRONMENT=production
ASAAS_API_URL=https://api.asaas.com/v3
ASAAS_PLATFORM_FEE=3

RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=120
TOKEN_ENCRYPTION_KEY=change-this-strong-marketplace-token-secret
