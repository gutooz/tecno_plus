AI_TEXT_PROVIDER=gemini
AI_VISION_MODEL=gemini-flash-latest
AI_TEXT_MODEL=gemini-flash-latest
AI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=product-images

